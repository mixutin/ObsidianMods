{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixutin.github.io/ObsidianMods/package.schema.json",
  "title": "Obsidian Mod Package Manifest",
  "type": "object",
  "required": ["schema", "id", "name", "version", "author", "loader", "game"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "loader": { "enum": ["pak", "iostore", "ue4ss-lua", "ue4ss-cpp"] },
    "game": { "const": "minecraft-dungeons-2" },
    "game_builds": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
