{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixutin.github.io/ObsidianMods/catalog.schema.json",
  "title": "Obsidian Mods Catalog",
  "type": "object",
  "required": ["schema", "generated_at", "mods"],
  "properties": {
    "schema": { "const": 1 },
    "generated_at": { "type": "string" },
    "mods": {
      "type": "array",
      "items": { "$ref": "#/$defs/mod" }
    }
  },
  "$defs": {
    "mod": {
      "type": "object",
      "required": [
        "id", "name", "version", "author", "summary", "description",
        "category", "loader", "game_build", "download_url", "sha256"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "loader": { "type": "string", "minLength": 1 },
        "game_build": { "type": "string", "minLength": 1 },
        "download_url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "featured": { "type": "boolean" },
        "status": { "enum": ["stable", "experimental", "blocked"] },
        "status_note": { "type": "string" },
        "screenshots": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
